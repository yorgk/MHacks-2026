# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Optional: override the model if this one is retired (check https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: run without hardware
# PROBE_MOCK=1
# PROBE_MOCK_SCENARIO=ok   # ok | wrong_address | empty | stuck_bus | freewili_kit
ELEVENLABS_API_KEY=
# Optional: which FREE-WILi Probe uses when two are plugged in (stand-in sensor rig)
# PROBE_SERIAL=FW4551
